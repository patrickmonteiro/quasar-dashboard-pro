# Copy to `.env` and restart the dev server. Only QCLI_-prefixed vars reach the browser bundle.

# Optional — free CoinGecko "Demo" API key (https://www.coingecko.com/en/api/pricing).
# The Crypto module works without it, but the keyless tier is heavily rate-limited.
# Never put a paid/Pro key here: everything in the frontend bundle is public.
QCLI_COINGECKO_API_KEY=
